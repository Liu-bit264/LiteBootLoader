{
  "schema_version": "2.2",
  "_note": "由 tools/uvprojx/chipfill.py 从 chips/<id>.json 渲染生成（ADR-015）；勿手改本文件与渲染产物，改芯片清单后重新生成。",
  "targets": [
    {
      "name": "app",
      "toolset": {
        "number": "0x4",
        "name": "ARM-ADS",
        "uac6": false,
        "pcc_used": "5060960::V5.06 update 7 (build 960)::.\\ARMCC"
      },
      "use_microlib": true,
      "device": {
        "name": "{{chip.device.name}}",
        "vendor": "{{chip.device.vendor}}",
        "pack_id": "{{chip.device.pack_id}}",
        "cpu": "{{chip.derived.cpu_app}}",
        "cpu_core": "{{chip.device.cputype}}",
        "debug_dll_args": "{{chip.device.debug_dll_args}}",
        "flash_driver": "{{chip.device.flash_driver}}",
        "register_file": "{{chip.device.register_file}}",
        "sfd_file": "{{chip.device.sfd_file}}"
      },
      "output": {
        "directory": ".\\Objects\\",
        "name": "app",
        "create_executable": true,
        "create_hex_file": false
      },
      "c_defines": "{{chip.build.c_defines}}",
      "c_include_paths": {
        "$chip": "build.include_paths_app"
      },
      "c_misc_controls": "-Ospace",
      "scatter_file": "{{chip.build.proj_rel}}{{chip.build.sct_dir}}\\app.sct",
      "groups": [
        {
          "name": "Startup",
          "files": [
            {
              "$chip": "build.startup_files"
            }
          ]
        },
        {
          "name": "App",
          "files": [
            {
              "name": "main.c",
              "type": 1,
              "path": "{{chip.build.proj_rel}}{{chip.build.app_example_dir}}\\main.c"
            },
            {
              "name": "app_request.c",
              "type": 1,
              "path": "{{chip.build.proj_rel}}{{chip.build.app_example_dir}}\\app_request.c"
            }
          ]
        },
        {
          "name": "Core",
          "files": [
            {
              "name": "bl_metadata.c",
              "type": 1,
              "path": "{{chip.build.proj_rel}}core\\bl_metadata.c"
            },
            {
              "name": "bl_crc.c",
              "type": 1,
              "path": "{{chip.build.proj_rel}}core\\bl_crc.c"
            }
          ]
        },
        {
          "name": "CMSIS",
          "files": [
            {
              "$chip": "build.cmsis_sources"
            }
          ]
        },
        {
          "name": "Port",
          "files": [
            {
              "$chip": "build.port_files_app"
            }
          ]
        },
        {
          "name": "BSP",
          "files": [
            {
              "$chip": "build.bsp_files_app"
            }
          ]
        }
      ]
    }
  ]
}
